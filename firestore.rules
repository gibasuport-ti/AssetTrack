rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DEFAULT DENY: Bloqueio total de acesso público / não autenticado
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Funções Auxiliares de Autenticação & Validação de Administrador
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Acesso administrativo e operacional restrito estritamente a gibasuporte@gmail.com
    function isVerifiedAdmin() {
      return isAuthenticated() && 
        request.auth.token.email == "gibasuporte@gmail.com" && 
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['NumeroPatrimonio', 'serial', 'marca', 'modelo', 'TipoEquipamento', 'EstadoEquipamento', 'DataAquisicao']) &&
             data.NumeroPatrimonio is string && data.NumeroPatrimonio.size() > 0 && data.NumeroPatrimonio.size() <= 100 &&
             data.serial is string && data.serial.size() > 0 && data.serial.size() <= 100 &&
             data.marca is string && data.marca.size() > 0 && data.marca.size() <= 100 &&
             data.modelo is string && data.modelo.size() > 0 && data.modelo.size() <= 150 &&
             data.TipoEquipamento is string && data.TipoEquipamento.size() > 0 && data.TipoEquipamento.size() <= 100 &&
             data.EstadoEquipamento is string && data.EstadoEquipamento.size() > 0 && data.EstadoEquipamento.size() <= 100 &&
             data.DataAquisicao is string && data.DataAquisicao.size() > 0 && data.DataAquisicao.size() <= 50 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('observacao' in data) || (data.observacao is string && data.observacao.size() <= 2000)) &&
             (!('situacao' in data) || (data.situacao is string && data.situacao.size() <= 100)) &&
             (!('colaboradorId' in data) || (data.colaboradorId is string && data.colaboradorId.size() <= 100)) &&
             (!('colaboradorNome' in data) || (data.colaboradorNome is string && data.colaboradorNome.size() <= 150)) &&
             (!('colaboradorEmail' in data) || (data.colaboradorEmail is string && data.colaboradorEmail.size() <= 150)) &&
             (!('fotos' in data) || (data.fotos is list && data.fotos.size() <= 6)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    // ===============================================================
    // Regras por Coleção
    // ===============================================================

    // Ativos do Inventário: Apenas admin autenticado gibasuporte@gmail.com
    match /assets/{assetId} {
      allow read: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin() && isValidAsset(request.resource.data);
      allow update: if isVerifiedAdmin() && isValidAsset(request.resource.data);
      allow delete: if isVerifiedAdmin();
    }

    // Usuários: Apenas admin autenticado gibasuporte@gmail.com
    match /users/{userId} {
      allow read, write: if isVerifiedAdmin() && isValidId(userId);
    }

    // Trilha de Auditoria: Apenas admin autenticado gibasuporte@gmail.com
    match /audit_logs/{logId} {
      allow read, create: if isVerifiedAdmin();
      allow update, delete: if isVerifiedAdmin();
    }

    // Configurações Globais de Segurança: Apenas admin autenticado gibasuporte@gmail.com
    match /security_settings/{settingId} {
      allow read, write: if isVerifiedAdmin();
    }
  }
}

