rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny-all. Specific matches below will override this.
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assets
    // Document ID: auto-generated or custom string
    // Fields:
    //   - id: string (required)
    //   - DataAquisicao: string (required)
    //   - TipoEquipamento: string (required)
    //   - marca: string (required)
    //   - modelo: string (required)
    //   - serial: string (required)
    //   - NumeroPatrimonio: string (required)
    //   - EstadoEquipamento: string (required)
    //   - observacao: string (optional)
    //   - createdAt: string (required, ISO 8601)
    //   - updatedAt: string (optional, ISO 8601)
    //   - uid: string (optional, owner ID)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         (request.auth.token.email == "gibasuporte@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['NumeroPatrimonio', 'serial', 'marca', 'modelo', 'TipoEquipamento', 'EstadoEquipamento', 'DataAquisicao']) &&
             data.NumeroPatrimonio is string && data.NumeroPatrimonio.size() > 0 &&
             data.serial is string && data.serial.size() > 0 &&
             data.marca is string && data.marca.size() > 0 &&
             data.modelo is string && data.modelo.size() > 0 &&
             data.TipoEquipamento is string && data.TipoEquipamento.size() > 0 &&
             data.EstadoEquipamento is string && data.EstadoEquipamento.size() > 0 &&
             data.DataAquisicao is string && data.DataAquisicao.size() > 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /assets/{assetId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidAsset(request.resource.data);
      allow update: if isAuthenticated() && isValidAsset(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
