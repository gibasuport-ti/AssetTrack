{
  "entities": {
    "Asset": {
      "title": "Asset",
      "description": "An asset tracked in the inventory system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "DataAquisicao": { "type": "string", "maxLength": 50 },
        "TipoEquipamento": { "type": "string", "maxLength": 100 },
        "marca": { "type": "string", "maxLength": 100 },
        "modelo": { "type": "string", "maxLength": 150 },
        "serial": { "type": "string", "maxLength": 100 },
        "NumeroPatrimonio": { "type": "string", "maxLength": 100 },
        "EstadoEquipamento": { "type": "string", "maxLength": 100 },
        "situacao": { "type": "string", "maxLength": 100 },
        "colaboradorId": { "type": "string", "maxLength": 100 },
        "colaboradorNome": { "type": "string", "maxLength": 150 },
        "colaboradorEmail": { "type": "string", "maxLength": 150 },
        "fotos": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "observacao": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "uid": { "type": "string", "maxLength": 128 }
      },
      "required": ["NumeroPatrimonio", "serial", "marca", "modelo", "TipoEquipamento", "EstadoEquipamento", "DataAquisicao"]
    }
  },
  "firestore": {
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Collection of inventory assets"
    }
  }
}
